function fb_name() :: text:
    return "&e&lInfinity Plank"

function fb_lore_line() :: texts:
    return "&7only useable in &bParkour Practice" and "&7Shift + Left Click to shift blocks"

function glowingItem(i: item) :: item: 
    set {_glowingItem} to {_i} 
    enchant {_glowingItem} with mending 
    add hide enchants to item flags of {_glowingItem} 
    return {_glowingItem}

