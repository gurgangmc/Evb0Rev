command build:
	permission: evb0.pro.tp
	cooldown: 60 seconds
	cooldown message: &cTry again later... %remaining time%
	trigger:
		teleport player to {location::build}
		send "&eTeleported to Build!" to player
		
command build:setspawn:
	permission: op
	trigger:
		set {location::build} to player's location

